<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="recall.db" />
        <include domain="sharedpref" path="recall_settings.xml" />
        <include domain="file" path="media/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="recall.db" />
        <include domain="sharedpref" path="recall_settings.xml" />
        <include domain="file" path="media/" />
    </device-transfer>
</data-extraction-rules>
